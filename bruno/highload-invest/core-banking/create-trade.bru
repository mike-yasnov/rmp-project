meta {
  name: Create Trade (BUY)
  type: http
  seq: 2
}

post {
  url: {{banking_url}}/api/trades
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{user_id}}",
    "ticker": "GAZP",
    "action": "BUY",
    "lots": 10,
    "pricePerLot": 150.50
  }
}

assert {
  res.status: eq 200
  res.body.ticker: eq GAZP
  res.body.action: eq BUY
  res.body.lots: eq 10
}
