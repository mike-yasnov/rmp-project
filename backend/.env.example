POSTGRES_DB=highload_invest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

REDIS_PORT=6379

API_GATEWAY_PORT=8080
CORE_BANKING_PORT=8081
DATABASE_MAX_POOL_SIZE=20
LOG_LEVEL=INFO

# If the Linux kernel module is loaded on the host, set QUOTES_DEVICE=/dev/quotes.
# The Go ingestion service falls back to an internal quote generator when /dev/quotes
# is not available.
QUOTES_DEVICE=/dev/null
INGESTION_BATCH_SIZE=100
INGESTION_INTERVAL_MS=500

# Load tester profile:
# docker compose --profile load up load-tester
BOT_COUNT=100
DURATION_SEC=60
