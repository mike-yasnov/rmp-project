POSTGRES_DB=highload_invest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

REDIS_PORT=6379

API_GATEWAY_PORT=8080
CORE_BANKING_PORT=8081
DATABASE_MAX_POOL_SIZE=20
LOG_LEVEL=INFO

# Default mode: Go ingestion uses an internal fallback generator.
QUOTES_DEVICE=/dev/null
QUOTES_REQUIRE_DEVICE=false
QUOTES_DEVICE_WAIT_SEC=0
INGESTION_BATCH_SIZE=100
INGESTION_INTERVAL_MS=500

# Kernel driver mode:
# docker compose -f docker-compose.yml -f docker-compose.driver.yml up -d --build
# This privileged compose override builds and loads module_for_generate_quotes into
# the host kernel, exposes host /dev/quotes to go-ingestion as /host-dev/quotes,
# and requires native Linux with matching linux-headers installed on the host.
DRIVER_RING_SIZE=64
DRIVER_INTERVAL_MS=500
DRIVER_SMOKE_READ_LINES=5

# Load tester profile:
# docker compose --profile load up load-tester
BOT_COUNT=100
DURATION_SEC=60
CREATE_PARALLELISM=100
ACTIVE_REQUESTS=50
WS_PERCENT=10
REQUEST_DELAY_MIN_MS=50
REQUEST_DELAY_MAX_MS=500

# Observability (OpenTelemetry stack)
OTEL_ENV=local
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
