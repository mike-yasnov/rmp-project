{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "HighLoad Invest — Backend Overview",
  "tags": ["highload-invest", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Trades — Success / sec",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(trades_success_total[1m]))",
          "legendFormat": "success",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 1}},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "Trades — Failed / sec",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(trades_failed_total[1m]))",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.1}]}}},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "Active WS connections",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(ws_active_connections)",
          "legendFormat": "ws",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "Quotes ingested / sec",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(quotes_ingested_total[1m]))",
          "legendFormat": "ingested",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "timeseries",
      "title": "HTTP requests / sec by service",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_server_request_duration_milliseconds_count[1m]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "HTTP latency P95 (ms)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_milliseconds_bucket[1m])))",
          "legendFormat": "{{service_name}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "ClickHouse insert duration P95/P99 (ms)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(clickhouse_insert_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(clickhouse_insert_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Trade execution duration P95/P99 (ms)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(trade_execute_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(trade_execute_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Redis pubsub messages received / sec",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(redis_pubsub_messages_total[1m]))",
          "legendFormat": "received",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "WS messages broadcast / sec",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(ws_messages_broadcast_total[1m]))",
          "legendFormat": "broadcast",
          "refId": "A"
        }
      ],
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6}
    }
  ]
}
